PORT=5000
MONGO_URI=mongodb://localhost:27017/goldentrans
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Cloud API (Meta) ──
# Obtenez WHATSAPP_TOKEN et WHATSAPP_PHONE_ID depuis :
# https://developers.facebook.com → WhatsApp → Business Platform
# WHATSAPP_TOKEN=<your-token>
# WHATSAPP_PHONE_ID=<your-phone-number-id>

# ── Email (Gmail SMTP) ──
# Créez un mot de passe d'application Gmail :
# https://myaccount.google.com/apppasswords
# EMAIL_USER=goldentrans68@gmail.com
# EMAIL_PASS=<16-char-app-password>

# ── IA (OpenRouter) ──
# VITE_ANTHROPIC_AUTH_TOKEN=<your-openrouter-key>

# ── Production (Railway) ──
# MONGO_URI : Set via Railway dashboard → MongoDB Atlas connection string
# FRONTEND_URL : https://golden-trans.pages.dev
# PORT          : Auto-set by Railway (do not override)
